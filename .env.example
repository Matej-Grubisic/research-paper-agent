# Copy this file to .env and fill in your key. Never commit .env.

# PydanticAI model string: "<provider>:<model>"
# Examples: groq:llama-3.3-70b-versatile | google-gla:gemini-2.5-flash
MODEL=groq:llama-3.3-70b-versatile

# Key for the chosen provider (use the one that matches MODEL)
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenAlex asks for an email to use their faster "polite pool" (optional)
OPENALEX_EMAIL=
